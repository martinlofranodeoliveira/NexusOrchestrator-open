# Copy to .env only after selecting a workspace and your own optional providers.
HOST=127.0.0.1
PORT=4000
NODE_ENV=development
PROJECT_DIR=./workspace
NEXUS_AUTO_DISPATCH=false
NEXUS_AUTO_DISPATCH_FROM_BACKLOG=false
NEXUS_BOOTSTRAP_DEMO_TASKS=false
NEXUS_ORPHAN_TASK_RESCUE=false
NEXUS_USE_GITHUB_BOARD=false
NEXUS_OPENCODE_VALIDATOR_ENABLED=false
NEXUS_OPENCODE_REVIEW_GATE_ENABLED=false
# Credentials intentionally blank. No hosted provider is provisioned by this release.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
FIGMA_ACCESS_TOKEN=
GITHUB_TOKEN=
GITLAB_TOKEN=
